+/// uv-nix: patch anything in `venv` that hasn't been patched yet.
+///
+/// The per-wheel hook in [`execute_plan`] only sees the wheels installed in
+/// this run. This also covers packages that were already present but never
+/// patched, and it has to run on the no-op paths, which skip the install step.
+pub fn nix_reconcile(venv: &PythonEnvironment) {
+    for site_packages_dir in venv.site_packages() {
+        if let Err(err) = uv_nix::reconcile_venv(&site_packages_dir) {
+            warn_user!(
+                "Failed to patch native binaries in `{}` for Nix: {err}",
+                site_packages_dir.user_display()
+            );
+        }
+    }
+}
