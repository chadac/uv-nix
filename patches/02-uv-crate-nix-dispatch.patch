diff --git a/crates/uv/src/commands/pip/operations.rs b/crates/uv/src/commands/pip/operations.rs
index aefa0d4..acec528 100644
--- a/crates/uv/src/commands/pip/operations.rs
+++ b/crates/uv/src/commands/pip/operations.rs
@@ -1116,6 +1116,10 @@ async fn execute_plan(
     let mut installs = wheels.into_iter().chain(cached).collect::<Vec<_>>();
     if !installs.is_empty() {
         let start = std::time::Instant::now();
+
+        // Warn if the venv is unpatched (one-time warning).
+        uv_nix::warn_if_unpatched_venv(venv.root());
+
         installs = uv_installer::Installer::new(venv, preview)
             .with_link_mode(link_mode)
             .with_cache(cache)
@@ -1128,6 +1132,17 @@ async fn execute_plan(
             // task.
             .install_blocking(installs)?;
 
+        // Patch native binaries for Nix compatibility.
+        // Build dist-info prefixes (e.g. "numpy-2.4.6") so uv-nix can find
+        // exactly which files were just installed via their RECORD files.
+        let nix_dist_prefixes: Vec<String> = installs
+            .iter()
+            .map(|d| format!("{}-{}", d.filename().name.as_dist_info_name(), d.filename().version))
+            .collect();
+        for site_packages_dir in venv.site_packages() {
+            uv_nix::post_install_patch(&site_packages_dir, &nix_dist_prefixes)?;
+        }
+
         logger.on_install(installs.len(), start, printer, DryRun::Disabled)?;
     }
 
